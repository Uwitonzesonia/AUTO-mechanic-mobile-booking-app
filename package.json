{
  "name": "auto-mechanic",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-native-vector-icons/ant-design": "^13.1.2",
    "@react-native-vector-icons/fontawesome": "^13.1.3",
    "@react-native-vector-icons/ionicons": "^13.1.2",
    "@react-native-vector-icons/material-design-icons": "^13.1.2",
    "expo": "~57.0.23",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.0",
    "expo-constants": "~57.0.14",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.18",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.18",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.19",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "firebase": "^12.18.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/fingerprint": "^0.20.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "native-sim": "^0.1.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "test": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "send:fcm": "node scripts/send-fcm.js",
    "sim": "native-sim up --public --agent",
    "sim:status": "native-sim status",
    "sim:down": "native-sim down",
    "fingerprint": "npx @expo/fingerprint .",
    "fingerprint:ios": "npx @expo/fingerprint fingerprint:generate --platform ios",
    "postinstall": "node scripts/patch-native-sim.js"
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverage": true,
    "coverageReporters": [
      "json-summary",
      "text",
      "lcov"
    ],
    "collectCoverageFrom": [
      "**/*.{ts,tsx,js,jsx}",
      "!**/coverage/**",
      "!**/node_modules/**",
      "!**/babel.config.js",
      "!**/jest.config.js",
      "!**/expo-env.d.ts",
      "!**/.expo/**",
      "!**/.expo-router/**",
      "!**/app/_layout.tsx"
    ]
  },
  "private": true
}
